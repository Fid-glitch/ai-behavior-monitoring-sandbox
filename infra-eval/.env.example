# Secure Autonomous AI Behavior Monitoring Sandbox
# Environment variable template.
# Copy this file to `.env` and adjust values for your environment:
#   cp .env.example .env

# --- Runtime environment -----------------------------------------------------
# One of: development | staging | production
ENVIRONMENT=development

# --- Database ----------------------------------------------------------------
# SQLAlchemy connection string (SQLite by default).
DATABASE_URL=sqlite:///./data/sandbox.db

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO

# --- Docker Sandbox ----------------------------------------------------------
# Docker network name used by the sandbox.
DOCKER_NETWORK=sandbox-net
# Sandbox command execution timeout (seconds).
SANDBOX_TIMEOUT_SECONDS=300
# Sandbox memory limit ('512m', '1g', ...).
SANDBOX_MEMORY_LIMIT=512m
# Sandbox CPU limit (number of CPUs).
SANDBOX_CPU_LIMIT=1.0

# --- Docker Compose (docker-compose.yml) -------------------------------------
# Resource limits applied to the sandbox service.
SANDBOX_CPU_LIMIT_COMPOSE=1.0
SANDBOX_MEMORY_LIMIT_COMPOSE=512M
